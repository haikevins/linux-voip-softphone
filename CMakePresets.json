{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "pjsip-debug",
      "inherits": "debug",
      "displayName": "Debug + PJSIP",
      "cacheVariables": {
        "ENABLE_PJSIP": "ON"
      }
    },
    {
      "name": "qt-debug",
      "inherits": "debug",
      "displayName": "Debug + Qt/QML GUI",
      "cacheVariables": {
        "ENABLE_QT_GUI": "ON"
      }
    },
    {
      "name": "qt-pjsip-debug",
      "inherits": "debug",
      "displayName": "Debug + Qt/QML GUI + PJSIP",
      "cacheVariables": {
        "ENABLE_QT_GUI": "ON",
        "ENABLE_PJSIP": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "displayName": "Debug + ASan + UBSan",
      "cacheVariables": {
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "thread-sanitizer",
      "inherits": "debug",
      "displayName": "Debug + ThreadSanitizer",
      "cacheVariables": {
        "ENABLE_TSAN": "ON",
        "CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "debug",
      "displayName": "Debug + clang-tidy",
      "cacheVariables": {
        "ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release + Qt/QML GUI + PJSIP",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "ENABLE_QT_GUI": "ON",
        "ENABLE_PJSIP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "pjsip-debug",
      "configurePreset": "pjsip-debug"
    },
    {
      "name": "qt-debug",
      "configurePreset": "qt-debug"
    },
    {
      "name": "qt-pjsip-debug",
      "configurePreset": "qt-pjsip-debug"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "thread-sanitizer",
      "configurePreset": "thread-sanitizer"
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "thread-sanitizer",
      "configurePreset": "thread-sanitizer",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt-debug",
      "configurePreset": "qt-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt-pjsip-debug",
      "configurePreset": "qt-pjsip-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

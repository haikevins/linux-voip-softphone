{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "pjsip-debug",
      "inherits": "debug",
      "displayName": "Debug + PJSIP",
      "cacheVariables": {
        "ENABLE_PJSIP": "ON"
      }
    },
    {
      "name": "qt-gui-debug",
      "inherits": "debug",
      "displayName": "Debug + Qt/QML GUI shell",
      "cacheVariables": {
        "ENABLE_QT_GUI": "ON"
      }
    },
    {
      "name": "qt-pjsip-gui-debug",
      "inherits": "debug",
      "displayName": "Debug + Qt/QML + PJSIP registration",
      "cacheVariables": {
        "ENABLE_QT_GUI": "ON",
        "ENABLE_PJSIP": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "displayName": "Debug + ASan + UBSan",
      "cacheVariables": {
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "debug",
      "displayName": "Debug + clang-tidy",
      "cacheVariables": {
        "ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "pjsip-debug",
      "configurePreset": "pjsip-debug"
    },
    {
      "name": "qt-gui-debug",
      "configurePreset": "qt-gui-debug"
    },
    {
      "name": "qt-pjsip-gui-debug",
      "configurePreset": "qt-pjsip-gui-debug"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt-gui-debug",
      "configurePreset": "qt-gui-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt-pjsip-gui-debug",
      "configurePreset": "qt-pjsip-gui-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

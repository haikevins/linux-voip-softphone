digraph Threading {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.7", fontsize=15,
         fontname="DejaVu Sans", label="Phase 8 — As-built Thread Boundaries (Commit 19)\nSource contract diagram, not a live trace", labelloc=t];
  node [shape=box, style="rounded,filled", color="#3d4b61", fillcolor="#f5f7fa", penwidth=1.3,
        fontname="DejaVu Sans", fontsize=12, margin="0.19,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#495b72", arrowsize=0.8];

  subgraph cluster_qt {
     label="Actual Qt GUI path (implemented prior to Phase 8 queue)";
     fontname="DejaVu Sans";
     color="#aabed1";
     style="rounded";
     backend [label="QtRegistrationBackend\nQObject owner / GUI thread",fillcolor="#e8f2fb"];
     app [label="GuiViewModel + CallManager\nowner-thread-only",fillcolor="#e8f2fb"];
     ui [label="QML / Qt UI thread",fillcolor="#e8f2fb"];
     backend -> app [label="Qt signals / slots"];
     app -> ui [label="state notifications"];
  }

  session [label="std::jthread\nRegistrationSession / PJSIP operations",fillcolor="#fcf3de"];
  session -> backend [label="QMetaObject::invokeMethod\nQt::QueuedConnection",constraint=false];
  backend -> session [label="requests via mutex / CV",color="#9f6f30"];

  subgraph cluster_isolated {
     label="Phase 8 concurrency lab (isolated; NOT connected to Qt/PJSIP)";
     fontname="DejaVu Sans";
     color="#8ebcaa";
     style="rounded,dashed";
     producers [label="4 producer threads",fillcolor="#e6f7f0"];
     queue [label="ThreadSafeQueue<T>\nmutex + CV / close",fillcolor="#e6f7f0"];
     consumers [label="4 consumer threads\n100,000-event MPMC test",fillcolor="#e6f7f0"];
     taskproducer [label="task posters (independent)",fillcolor="#e6f7f0"];
     taskqueue [label="SerialTaskWorker\ninternal queue + 1 std::jthread\nNOT integrated with Qt/PJSIP",fillcolor="#e6f7f0"];
     producers -> queue -> consumers;
     taskproducer -> taskqueue [label="post(Task)"];
  }
  block [label="Real PJSUA2 shutdown safety\nBLOCKED / not validated", fillcolor="#fff1f0", color="#ad645e"];
  session -> block [label="callback lifetime risk",style=dashed,color="#ad645e"];
}

; Phase 4 local Asterisk lab configuration.
; This file is intentionally minimal and defines two dynamic SIP endpoints.
; Copy it to /etc/asterisk/pjsip.conf only after backing up the existing file.
;
; Example credentials are for an isolated LAN lab only. Change them before use
; on any network you do not fully control.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

; -----------------------------------------------------------------------------
; Endpoint 1001
; -----------------------------------------------------------------------------

[1001]
type=endpoint
transport=transport-udp
context=voip-lab
disallow=all
allow=ulaw
auth=auth1001
aors=1001
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[auth1001]
type=auth
auth_type=userpass
username=1001
password=voip-lab-1001

[1001]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

; -----------------------------------------------------------------------------
; Endpoint 1002
; -----------------------------------------------------------------------------

[1002]
type=endpoint
transport=transport-udp
context=voip-lab
disallow=all
allow=ulaw
auth=auth1002
aors=1002
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[auth1002]
type=auth
auth_type=userpass
username=1002
password=voip-lab-1002

[1002]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30
